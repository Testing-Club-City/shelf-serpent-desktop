import React, { useState, useCallback, useMemo, memo, useEffect } from 'react';
import { 
  AlertCircle, 
  AlertTriangle, 
  BarChart2, 
  Book, 
  BookOpen, 
  CheckCircle, 
  Copy, 
  Database, 
  Download, 
  GraduationCap, 
  RefreshCw, 
  ShieldAlert, 
  Tags, 
  Trash2, 
  Upload,
  UserCog, 
  Users, 
  Users2, 
  WifiOff 
} from 'lucide-react';
import { toast } from 'sonner';
import { useConnectivity } from '@/hooks/useConnectivity';
import { useProfessionalSync } from '@/hooks/useProfessionalSync';
import {
  ContextMenu,
  ContextMenuContent,
  ContextMenuItem,
  ContextMenuSeparator,
  ContextMenuSub,
  ContextMenuSubContent,
  ContextMenuSubTrigger,
  ContextMenuTrigger,
} from '@/components/ui/context-menu';
import { Button } from '@/components/ui/button';
import { Tooltip, TooltipContent, TooltipTrigger } from '@/components/ui/tooltip';
import { cn } from '@/lib/utils';

// Define a type that includes all the number fields from SyncStats
type DatabaseStats = {
  books: number;
  students: number;
  categories: number;
  borrowings: number;
  staff: number;
  classes: number;
  bookCopies: number;
  fines: number;
  fineSettings: number;
  groupBorrowings: number;
  theftReports: number;
  [key: string]: number; // Index signature for dynamic access
};

// Remove the ProfessionalSync interface as we'll use the return type of useProfessionalSync directly

interface WindowsContextMenuProps {
  children: React.ReactNode;
  className?: string;
  onSyncComplete?: () => void;
  onSyncError?: (error: Error) => void;
}

export const WindowsContextMenu = memo(({ 
  children, 
  className,
  onSyncComplete = () => {},
  onSyncError = () => {}
}: WindowsContextMenuProps): JSX.Element => {
  const [isOpen, setIsOpen] = useState(false);
  const [isInitialized, setIsInitialized] = useState(false);
  const [localStats, setLocalStats] = useState<DatabaseStats>({ 
    books: 0, 
    students: 0, 
    categories: 0,
    borrowings: 0,
    staff: 0,
    classes: 0,
    bookCopies: 0,
    fines: 0,
    fineSettings: 0,
    groupBorrowings: 0,
    theftReports: 0
  });
  
  const { 
    isOnline, 
    isLoading: isCheckingConnectivity, 
    refresh: refreshConnectivity,
    connectionQuality
  } = useConnectivity();
  
  const { 
    loading,
    syncNeeded,
    connectivity,
    performFullSync,
    uploadLocalChanges,
    totalUnsyncedCount
  } = useProfessionalSync();

  // Get sync status icon based on current state
  const getSyncStatusIcon = useCallback(() => {
    if (loading) return <RefreshCw className="h-4 w-4 animate-spin text-blue-500" />;
    if (!connectivity.connected) return <WifiOff className="h-4 w-4 text-red-500" />;
    if (syncNeeded) return <Upload className="h-4 w-4 text-yellow-500" />;
    return <CheckCircle className="h-4 w-4 text-green-500" />;
  }, [connectivity.connected, loading, syncNeeded]);

  // Get sync status text
  const getSyncStatusText = useCallback(() => {
    if (loading) return 'Syncing...';
    if (!connectivity.connected) return 'Offline - Sync unavailable';
    if (syncNeeded) return `${totalUnsyncedCount} records need sync`;
    return 'All data synced';
  }, [connectivity.connected, loading, syncNeeded, totalUnsyncedCount]);

  // Initialize component and fetch necessary data
  useEffect(() => {
    const initialize = async () => {
      if (isOpen && !isInitialized) {
        try {
          // Always trigger a fresh connectivity check when menu opens
          console.log('Context menu opened - triggering fresh connectivity check');
          refreshConnectivity().then(() => {
            console.log('Context menu connectivity check completed');
          }).catch(error => {
            console.warn('Connectivity refresh failed during initialization:', error);
          });
          
          const stats = await fetchLocalStats();
          // Convert SyncStats to DatabaseStats
          const dbStats: DatabaseStats = {
            books: stats.books || 0,
            students: stats.students || 0,
            categories: stats.categories || 0,
            borrowings: stats.borrowings || 0,
            staff: stats.staff || 0,
            classes: stats.classes || 0,
            bookCopies: stats.bookCopies || 0,
            fines: stats.fines || 0,
            fineSettings: stats.fineSettings || 0,
            groupBorrowings: stats.groupBorrowings || 0,
            theftReports: stats.theftReports || 0
          };
          setLocalStats(dbStats);
          setIsInitialized(true);
        } catch (error) {
          console.error('Failed to initialize context menu:', error);
          onSyncError?.(error instanceof Error ? error : new Error('Failed to initialize'));
        }
      }
    };

    if (isOpen) {
      initialize();
    } else {
      // Reset initialization when menu closes to ensure fresh data next time
      setIsInitialized(false);
    }
  }, [isOpen, isInitialized, refreshConnectivity, fetchLocalStats, onSyncError]);

  // Ensure syncProgress has all required properties
  const syncProgressWithDefaults: SyncProgress = useMemo(() => ({
    issyncing: syncProgress?.issyncing || false,
    progress: syncProgress?.progress || 0,
    total: syncProgress?.total || 0,
    currentTask: syncProgress?.currentTask || '',
    lastSync: syncProgress?.lastSync || 'Never',
    errors: syncProgress?.errors || []
  }), [syncProgress]);

  // Connection status text with enhanced feedback
  const connectionStatusText = useMemo(() => {
    if (isCheckingConnectivity) return 'Checking connection...';
    if (!isOnline) return 'Offline';
    
    switch (connectionQuality) {
      case 'excellent': return 'Online (Excellent)';
      case 'good': return 'Online (Good)';
      case 'poor': return 'Online (Poor)';
      default: return 'Online';
    }
  }, [isOnline, isCheckingConnectivity, connectionQuality]);

  // Enhanced status color based on connectivity
  const getStatusColor = useCallback(() => {
    if (isCheckingConnectivity) return 'text-blue-600';
    if (!isOnline) return 'text-red-600';
    
    switch (connectionQuality) {
      case 'excellent': return 'text-green-600';
      case 'good': return 'text-green-500';
      case 'poor': return 'text-yellow-600';
      default: return 'text-green-500';
    }
  }, [isOnline, isCheckingConnectivity, connectionQuality]);


  // Format last sync time
  const getLastSyncText = useCallback(() => {
    if (!syncProgressWithDefaults.lastSync) return 'Never synced';
    try {
      const date = new Date(syncProgressWithDefaults.lastSync);
      if (isNaN(date.getTime())) return 'Invalid date';
      
      const now = new Date();
      const diffInMinutes = Math.floor((now.getTime() - date.getTime()) / (1000 * 60));
      
      if (diffInMinutes < 1) return 'Just now';
      if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
      if (diffInMinutes < 24 * 60) return `${Math.floor(diffInMinutes / 60)}h ago`;
      return date.toLocaleDateString();
    } catch (error) {
      console.error('Error formatting last sync time:', error);
      return 'Unknown';
    }
  }, [syncProgressWithDefaults.lastSync]);

  // Handle quick sync operation
  const handleQuickSync = useCallback(async () => {
    if (!isOnline) {
      toast.error('Cannot sync - No internet connection');
      return;
    }
    if (issyncing) {
      toast.warning('Sync already in progress');
      return;
    }
    
    try {
      const toastId = toast.loading('Starting quick sync...');
      const result = await syncAll();
      
      if (result) {
        // Convert SyncStats to DatabaseStats
        const dbStats: DatabaseStats = {
          books: result.books || 0,
          students: result.students || 0,
          categories: result.categories || 0,
          borrowings: result.borrowings || 0,
          staff: result.staff || 0,
          classes: result.classes || 0,
          bookCopies: result.bookCopies || 0,
          fines: result.fines || 0,
          fineSettings: result.fineSettings || 0,
          groupBorrowings: result.groupBorrowings || 0,
          theftReports: result.theftReports || 0
        };
        
        // Update local stats with the sync result
        setLocalStats(dbStats);
        
        toast.success('Quick sync completed successfully!', { 
          id: toastId,
          description: `Synced ${result.books} books, ${result.students} students, and ${result.borrowings} borrowings`
        });
        
        onSyncComplete?.();
      }
    } catch (error) {
      console.error('Quick sync failed:', error);
      const errorMessage = error instanceof Error ? error.message : 'Quick sync failed';
      toast.error(errorMessage);
      onSyncError?.(error instanceof Error ? error : new Error(errorMessage));
    }
  }, [isOnline, issyncing, syncAll, onSyncComplete, onSyncError, fetchLocalStats]);

  // Handle specific table sync
  const handleSyncSpecific = useCallback(async (
    syncFn: (limit?: number) => Promise<SyncStats>,
    tableName: string,
    limit?: number
  ) => {
    if (!isOnline) {
      toast.error(`Cannot sync ${tableName} - No internet connection`);
      return;
    }
    if (issyncing) {
      toast.warning('Sync already in progress');
      return;
    }
    
    try {
      const toastId = toast.loading(`Syncing ${tableName}...`);
      const result = await syncFn(limit);
      
      if (result) {
        // Convert SyncStats to DatabaseStats
        const dbStats: DatabaseStats = {
          books: result.books || 0,
          students: result.students || 0,
          borrowings: result.borrowings || 0,
          categories: result.categories || 0,
          staff: result.staff || 0,
          classes: result.classes || 0,
          bookCopies: result.bookCopies || 0,
          fines: result.fines || 0,
          fineSettings: result.fineSettings || 0,
          groupBorrowings: result.groupBorrowings || 0,
          theftReports: result.theftReports || 0
        };
        
        // Update local stats with the sync result
        setLocalStats(dbStats);
        
        // Generate description based on the table being synced
        let description = '';
        if (tableName === 'Books') description = `Synced ${result.books} books`;
        else if (tableName === 'Students') description = `Synced ${result.students} students`;
        else if (tableName === 'Borrowings') description = `Synced ${result.borrowings} borrowings`;
        else if (tableName === 'Categories') description = `Synced ${result.categories} categories`;
        else if (tableName === 'Staff') description = `Synced ${result.staff} staff members`;
        else if (tableName === 'Classes') description = `Synced ${result.classes} classes`;
        else if (tableName === 'Book Copies') description = `Synced ${result.bookCopies} book copies`;
        else if (tableName === 'Fines') description = `Synced ${result.fines || 0} fines`;
        else if (tableName === 'Group Borrowings') description = `Synced ${result.groupBorrowings || 0} group borrowings`;
        else if (tableName === 'Theft Reports') description = `Synced ${result.theftReports || 0} theft reports`;
        
        toast.success(`${tableName} synced successfully!`, { 
          id: toastId,
          description
        });
        
        onSyncComplete?.();
      }
    } catch (error) {
      console.error(`Error syncing ${tableName}:`, error);
      const errorMessage = error instanceof Error ? error.message : `Failed to sync ${tableName}`;
      toast.error(errorMessage);
      onSyncError?.(error instanceof Error ? error : new Error(errorMessage));
    }
  }, [isOnline, issyncing, onSyncComplete, onSyncError]);

  // Handle database pull operation
  const handlePullDatabase = useCallback(async () => {
    if (!isOnline) {
      toast.error('Cannot pull database - No internet connection');
      return;
    }
    if (issyncing) {
      toast.warning('Sync already in progress');
      return;
    }

    try {
      const toastId = toast.loading('Pulling complete database from server...');
      const result = await pullAllDatabase();
      
      if (result) {
        // Convert SyncStats to DatabaseStats
        const dbStats: DatabaseStats = {
          books: result.books || 0,
          students: result.students || 0,
          categories: result.categories || 0,
          borrowings: result.borrowings || 0,
          staff: result.staff || 0,
          classes: result.classes || 0,
          bookCopies: result.bookCopies || 0,
          fines: result.fines || 0,
          fineSettings: result.fineSettings || 0,
          groupBorrowings: result.groupBorrowings || 0,
          theftReports: result.theftReports || 0
        };

        // Update local stats with the pull result
        setLocalStats(dbStats);
        
        toast.success('Database pulled successfully!', { 
          id: toastId,
          description: `Pulled ${result.books} books, ${result.students} students, and ${result.borrowings} borrowings`
        });
        
        onSyncComplete?.();
      }
    } catch (error) {
      console.error('Database pull failed:', error);
      const errorMessage = error instanceof Error ? error.message : 'Failed to pull database';
      toast.error(errorMessage);
      onSyncError(error instanceof Error ? error : new Error(errorMessage));
    }
  }, [isOnline, issyncing, pullAllDatabase, onSyncComplete, onSyncError, fetchLocalStats]);

  // Handle clear database operation
  const handleClearDatabase = useCallback(async () => {
    if (!window.confirm('Are you sure you want to clear the local database? This action cannot be undone.')) {
      return;
    }
    
    try {
      const toastId = toast.loading('Clearing local database...');
      
      // Clear database and handle the result
      await clearDatabase();
      
      // Reset local stats after clear with all required fields
      const emptyStats: DatabaseStats = { 
        books: 0, 
        students: 0, 
        categories: 0,
        borrowings: 0,
        staff: 0,
        classes: 0,
        bookCopies: 0,
        fines: 0,
        fineSettings: 0,
        groupBorrowings: 0,
        theftReports: 0
      };
      
      setLocalStats(emptyStats);
      
      toast.success('Local database cleared successfully', { 
        id: toastId,
        description: 'All local data has been removed'
      });
      
      onSyncComplete?.();
    } catch (error) {
      console.error('Failed to clear database:', error);
      const errorMessage = error instanceof Error ? error.message : 'Failed to clear database';
      toast.error(errorMessage);
      onSyncError?.(error instanceof Error ? error : new Error(errorMessage));
    }
  }, [clearDatabase, onSyncComplete, onSyncError]);

  // Handle showing database statistics
  const handleShowStats = useCallback(() => {
    toast.info(
      <div className="space-y-1">
        <p className="font-medium">Database Statistics</p>
        <div className="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
          <span className="text-muted-foreground">Books:</span>
          <span className="font-mono">{localStats.books || 0}</span>
          <span className="text-muted-foreground">Students:</span>
          <span className="font-mono">{localStats.students || 0}</span>
          <span className="text-muted-foreground">Borrowings:</span>
          <span className="font-mono">{localStats.borrowings || 0}</span>
          {localStats.categories !== undefined && (
            <>
              <span className="text-muted-foreground">Categories:</span>
              <span className="font-mono">{localStats.categories || 0}</span>
            </>
          )}
          {localStats.staff !== undefined && (
            <>
              <span className="text-muted-foreground">Staff:</span>
              <span className="font-mono">{localStats.staff || 0}</span>
            </>
          )}
          {localStats.classes !== undefined && (
            <>
              <span className="text-muted-foreground">Classes:</span>
              <span className="font-mono">{localStats.classes || 0}</span>
            </>
          )}
        </div>
      </div>,
      { 
        duration: 5000,
        id: 'db-stats',
        position: 'bottom-right'
      }
    );
  }, [localStats]);

  return (
    <ContextMenu onOpenChange={setIsOpen}>
      <ContextMenuTrigger 
        className={className}
        aria-label="Open sync and database management menu"
      >
        {children}
      </ContextMenuTrigger>
      
      <ContextMenuContent 
        className="w-72 max-h-[80vh] overflow-y-auto"
        onEscapeKeyDown={() => setIsOpen(false)}
      >
        {/* Connection Status Section */}
        <div 
          className="px-3 py-2.5 text-sm border-b border-border/50"
          aria-live="polite"
          aria-atomic="true"
        >
          <div className="flex items-center gap-2.5">
            <div className="flex-shrink-0 flex items-center justify-center w-6">
              {getSyncStatusIcon()}
            </div>
            <div className="flex-1 min-w-0">
              <div className={cn("font-medium truncate", getStatusColor())}>
                {connectionStatusText}
              </div>
              <div className="text-xs text-muted-foreground truncate">
                Last sync: {getLastSyncText() ?? 'N/A'}
              </div>
            </div>
            <Tooltip>
              <TooltipTrigger asChild>
                <Button 
                  variant="ghost" 
                  size="icon" 
                  className="h-6 w-6"
                  onClick={(e) => {
                    e.stopPropagation();
                    refreshConnectivity();
                  }}
                  disabled={isCheckingConnectivity}
                  aria-label="Refresh connection status"
                >
                  <RefreshCw className={`h-3.5 w-3.5 ${isCheckingConnectivity ? 'animate-spin' : ''}`} />
                </Button>
              </TooltipTrigger>
              <TooltipContent side="right" sideOffset={8}>
                <p>Refresh connection</p>
              </TooltipContent>
            </Tooltip>
          </div>
          
          {issyncing && (
            <div className="mt-2 w-full bg-secondary/20 rounded-full h-1.5">
              <div 
                className="bg-primary h-1.5 rounded-full transition-all duration-300 ease-in-out"
                style={{
                  width: `${syncProgress.progress}%`,
                  opacity: syncProgress.progress === 100 ? 0.7 : 1
                }}
                aria-valuenow={syncProgress.progress}
                aria-valuemin={0}
                aria-valuemax={100}
                role="progressbar"
              />
            </div>
          )}
        </div>
        
        {/* Sync Actions Section */}
        <div className="p-1">
          <ContextMenuItem 
            onClick={handleQuickSync}
            disabled={!isOnline || issyncing}
            className="flex items-center gap-2.5 px-3 py-2 text-sm rounded-md"
            aria-label="Quick sync all data"
          >
            <RefreshCw className="h-4 w-4" />
            <span>Quick Sync</span>
            <kbd className="ml-auto text-xs opacity-60">⌘S</kbd>
          </ContextMenuItem>
          
          <ContextMenuItem 
            onClick={handlePullDatabase}
            disabled={!isOnline || issyncing}
            className="flex items-center gap-2.5 px-3 py-2 text-sm rounded-md"
            aria-label="Pull complete database from server"
          >
            <Download className="h-4 w-4" />
            <span>Pull Database</span>
            <span className="ml-auto text-xs opacity-60">Force</span>
          </ContextMenuItem>
          
          <ContextMenuSeparator className="my-1" />
          
          {/* Sync Specific Tables */}
          <ContextMenuSub>
            <ContextMenuSubTrigger 
              className="flex items-center gap-2.5 px-3 py-2 text-sm rounded-md"
              disabled={!isOnline || issyncing}
            >
              <Database className="h-4 w-4" />
              <span>Sync Specific Table</span>
            </ContextMenuSubTrigger>
            <ContextMenuSubContent className="w-56">
              <div className="px-2 py-1.5 text-xs font-medium text-muted-foreground">
                Select a table to sync
              </div>
              <ContextMenuSeparator className="mb-1" />
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncBooks, 'Books')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <Book className="h-4 w-4" />
                <span>Books</span>
                <span className="ml-auto text-xs opacity-60">{localStats.books || 0}</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncStudents, 'Students')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <Users className="h-4 w-4" />
                <span>Students</span>
                <span className="ml-auto text-xs opacity-60">{localStats.students || 0}</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncBorrowings, 'Borrowings')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <BookOpen className="h-4 w-4" />
                <span>Borrowings</span>
                <span className="ml-auto text-xs opacity-60">{localStats.borrowings || 0}</span>
              </ContextMenuItem>
              
              <ContextMenuSeparator className="my-1" />
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncStaff, 'Staff')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <UserCog className="h-4 w-4" />
                <span>Staff</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncCategories, 'Categories')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <Tags className="h-4 w-4" />
                <span>Categories</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncClasses, 'Classes')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-sm rounded"
              >
                <GraduationCap className="h-4 w-4" />
                <span>Classes</span>
              </ContextMenuItem>
              
              <ContextMenuSeparator className="my-1" />
              
              <div className="px-2 py-1.5 text-xs font-medium text-muted-foreground">
                Advanced
              </div>
              <ContextMenuSeparator className="mb-1" />
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncBookCopies, 'Book Copies')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-xs rounded"
              >
                <Copy className="h-3.5 w-3.5" />
                <span>Book Copies</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncFines, 'Fines')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-xs rounded"
              >
                <AlertCircle className="h-3.5 w-3.5" />
                <span>Fines</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncGroupBorrowings, 'Group Borrowings')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-xs rounded"
              >
                <Users2 className="h-3.5 w-3.5" />
                <span>Group Borrowings</span>
              </ContextMenuItem>
              
              <ContextMenuItem 
                onClick={() => handleSyncSpecific(syncTheftReports, 'Theft Reports')}
                disabled={!isOnline || issyncing}
                className="flex items-center gap-2.5 px-3 py-2 text-xs rounded"
              >
                <ShieldAlert className="h-3.5 w-3.5" />
                <span>Theft Reports</span>
              </ContextMenuItem>
            </ContextMenuSubContent>
          </ContextMenuSub>
          
          <ContextMenuSeparator className="my-1" />
          
          {/* Database Management */}
          <ContextMenuItem 
            onClick={handleShowStats}
            className="flex items-center gap-2.5 px-3 py-2 text-sm rounded-md"
            aria-label="Show database statistics"
          >
            <BarChart2 className="h-4 w-4" />
            <span>Database Stats</span>
          </ContextMenuItem>
          
          <ContextMenuItem 
            onClick={handleClearDatabase}
            disabled={issyncing}
            className="text-destructive focus:text-destructive/90 dark:text-red-400 dark:focus:text-red-300 flex items-center gap-2.5 px-3 py-2 text-sm rounded-md"
            aria-label="Clear local database"
          >
            <Trash2 className="h-4 w-4" />
            <span>Clear Local Database</span>
          </ContextMenuItem>
        </div>
        
        {/* Footer with version and sync info */}
        <div className="px-3 py-1.5 text-[10px] text-muted-foreground border-t border-border/50 flex justify-between items-center">
          <span>v{import.meta.env.VITE_APP_VERSION || '1.0.0'}</span>
          <div className="flex items-center gap-1.5">
            {issyncing && (
              <>
                <span className="flex h-2 w-2 relative">
                  <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/75"></span>
                  <span className="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                </span>
                <span>Syncing...</span>
              </>
            )}
            {!isOnline && (
              <span className="flex items-center gap-1">
                <WifiOff className="h-3 w-3" />
                <span>Offline Mode</span>
              </span>
            )}
          </div>
        </div>
      </ContextMenuContent>
    </ContextMenu>
  );
});

export default WindowsContextMenu;
