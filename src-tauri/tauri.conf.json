{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kisii School Library System",
  "version": "1.0.0",
  "identifier": "com.tamnet.kisiischool.library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kisii School Library System",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:library.db"]
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["migrations/*"],
    "externalBin": [],
    "copyright": "© 2025 Tamnet Systems - Kisii School Library",
    "category": "Productivity",
    "shortDescription": "Kisii School Library Management System",
    "longDescription": "Professional library management system for Kisii School, featuring barcode scanning, offline capabilities, and real-time synchronization. Powered by Tamnet Systems.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",

      "wix": {
        "language": "en-US"
      }
    }
  }
}
