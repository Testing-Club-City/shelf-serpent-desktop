#[cfg(test)]
mod sync_tests {
    use std::sync::Arc;
    use tokio::sync::RwLock;
    use crate::sync::SyncEngine;
    use crate::sync::SupabaseConfig;
    use crate::sync::SyncStatus;
    use crate::database::DatabaseManager;
    use crate::sync::error::SyncResult;

    #[tokio::test]
    async fn test_fetch_students_and_staff_multithreaded() {
        // Setup test database
        let db = Arc::new(DatabaseManager::new(":memory:").expect("Failed to create test database"));
        
        // Initialize tables
        db.initialize().await.expect("Failed to initialize database");
        
        // Setup sync engine configuration for testing
        let config = SupabaseConfig {
            url: std::env::var("TEST_SUPABASE_URL").unwrap_or_else(|_| "http://localhost:54321".to_string()),
            anon_key: std::env::var("TEST_SUPABASE_ANON_KEY").unwrap_or_else(|_| "test_key".to_string()),
            batch_size: 100,
        };
        
        let client = reqwest::Client::new();
        
        // Create sync engine directly for testing
        let sync_engine = create_test_sync_engine(db.clone(), config, client).await;
        
        // Test initial status
        let initial_status = sync_engine.get_status().await;
        assert!(!initial_status.is_syncing);
        
        // Skip actual network requests in tests unless environment variable is set
        if std::env::var("RUN_NETWORK_TESTS").is_ok() {
            // Test connectivity check
            let is_online = sync_engine.check_connectivity().await;
            println!("Connectivity test result: {}", is_online);
            
            if is_online {
                // Test the full data pull
                let result = sync_engine.trigger_data_pull().await;
                
                match result {
                    Ok(_) => {
                        println!("Data pull completed successfully");
                        
                        // Verify that data was fetched and stored
                        let students = db.get_students().await.expect("Failed to get students from DB");
                        let staff = db.get_staff().await.expect("Failed to get staff from DB");
                        
                        println!("Students fetched: {}", students.len());
                        println!("Staff fetched: {}", staff.len());
                        
                        // Assert that we have some data (count > 0)
                        // This is the main requirement from the task
                        assert!(students.len() > 0 || staff.len() > 0, 
                               "Should have fetched at least some students or staff data");
                        
                        // Test that students have required fields parsed correctly
                        if !students.is_empty() {
                            let first_student = &students[0];
                            assert!(!first_student.first_name.is_empty(), "Student first_name should not be empty");
                            assert!(!first_student.last_name.is_empty(), "Student last_name should not be empty");
                            assert!(!first_student.class_grade.is_empty(), "Student class_grade should not be empty");
                            // email is optional, so we don't assert on it
                            println!("First student: {} {} (Class: {})", 
                                   first_student.first_name, first_student.last_name, first_student.class_grade);
                        }
                        
                        // Test that staff have required fields parsed correctly
                        if !staff.is_empty() {
                            let first_staff = &staff[0];
                            assert!(!first_staff.first_name.is_empty(), "Staff first_name should not be empty");
                            assert!(!first_staff.last_name.is_empty(), "Staff last_name should not be empty");
                            // department, position, email are optional but should be properly handled if present
                            println!("First staff: {} {} (Dept: {:?}, Position: {:?})", 
                                   first_staff.first_name, first_staff.last_name, 
                                   first_staff.department, first_staff.position);
                        }
                        
                        // Verify sync status was updated
                        let final_status = sync_engine.get_status().await;
                        assert!(final_status.initial_sync_completed, "Initial sync should be marked as completed");
                        assert!(final_status.last_sync.is_some(), "Last sync time should be recorded");
                        assert!(!final_status.is_syncing, "Should not be syncing after completion");
                        
                    }
                    Err(e) => {
                        println!("Data pull failed (this might be expected in test environment): {}", e);
                        // Don't fail the test if network is unavailable in test environment
                        if e.to_string().contains("No internet connection") {
                            println!("Skipping network-dependent test due to connectivity issues");
                        } else {
                            panic!("Unexpected error during data pull: {}", e);
                        }
                    }
                }
            } else {
                println!("Network not available - skipping network-dependent tests");
            }
        } else {
            println!("Skipping network tests (set RUN_NETWORK_TESTS=1 to enable)");
            
            // Test offline functionality - verify database can handle empty results
            let students = db.get_students().await.expect("Failed to get students from DB");
            let staff = db.get_staff().await.expect("Failed to get staff from DB");
            
            // In a fresh test database, these should be empty
            println!("Initial students count: {}", students.len());
            println!("Initial staff count: {}", staff.len());
            
            // The test passes if we can query without errors, even with empty results
            assert_eq!(students.len(), 0);
            assert_eq!(staff.len(), 0);
        }
    }

    #[tokio::test] 
    async fn test_multithreaded_fetch_functions_exist() {
        // This test verifies that the required multithreaded functions exist and can be called
        // without actually performing network requests
        
        let db = Arc::new(DatabaseManager::new(":memory:").expect("Failed to create test database"));
        db.initialize().await.expect("Failed to initialize database");
        
        let config = SupabaseConfig {
            url: "http://localhost:54321".to_string(),
            anon_key: "test_key".to_string(),
            batch_size: 100,
        };
        
        let client = reqwest::Client::new();
        let sync_engine = create_test_sync_engine(db, config, client).await;
        
        // Test that trigger_data_pull exists and can be called
        // (it will fail due to network, but that's expected)
        let result = sync_engine.trigger_data_pull().await;
        
        // The function should exist and return a Result
        match result {
            Ok(_) => println!("trigger_data_pull succeeded (unexpected in test)"),
            Err(e) => {
                println!("trigger_data_pull failed as expected: {}", e);
                // Verify it's a network-related error, not a compilation error
                let error_msg = e.to_string().to_lowercase();
                assert!(
                    error_msg.contains("connection") || 
                    error_msg.contains("network") || 
                    error_msg.contains("timeout") ||
                    error_msg.contains("failed to fetch") ||
                    error_msg.contains("http"),
                    "Expected network-related error, got: {}", e
                );
            }
        }
    }

    async fn create_test_sync_engine(
        db: Arc<DatabaseManager>,
        config: SupabaseConfig, 
        client: reqwest::Client
    ) -> SyncEngine {
        // Create a minimal sync engine for testing
        // Note: This creates a basic engine without full remote/local/resolver implementations
        // but sufficient for testing the trigger_data_pull functionality
        
        SyncEngine {
            remote: Arc::new(TestRemoteDataSource),
            local: Arc::new(TestLocalDataStore),
            conflict_resolver: Arc::new(TestConflictResolver),
            strategies: Arc::new(RwLock::new(std::collections::HashMap::new())),
            status: Arc::new(RwLock::new(SyncStatus {
                is_online: false,
                is_syncing: false,
                last_sync: None,
                last_error: None,
                database_initialized: true,
                initial_sync_completed: false,
            })),
            db,
            config,
            client,
            supabase_client: None,
        }
    }

    // Minimal test implementations for required traits
    struct TestRemoteDataSource;
    struct TestLocalDataStore;
    struct TestConflictResolver;

    #[async_trait::async_trait]
    impl crate::sync::traits::RemoteDataSource for TestRemoteDataSource {
        async fn check_connectivity(&self) -> bool {
            false // Always return false for tests unless network tests are enabled
        }
        
        async fn fetch_changes(
            &self, 
            _table_name: &str, 
            _since: Option<chrono::DateTime<chrono::Utc>>
        ) -> SyncResult<Vec<serde_json::Value>> {
            Ok(vec![])
        }
        
        async fn push_changes(
            &self, 
            _table_name: &str, 
            _changes: Vec<serde_json::Value>
        ) -> SyncResult<()> {
            Ok(())
        }
    }

    #[async_trait::async_trait]
    impl crate::sync::traits::LocalDataStore for TestLocalDataStore {
        async fn get_changes(
            &self, 
            _table_name: &str, 
            _since: Option<chrono::DateTime<chrono::Utc>>
        ) -> SyncResult<Vec<serde_json::Value>> {
            Ok(vec![])
        }
        
        async fn apply_changes(
            &self, 
            _table_name: &str, 
            _changes: Vec<serde_json::Value>
        ) -> SyncResult<()> {
            Ok(())
        }
        
        async fn mark_synced(
            &self, 
            _table_name: &str, 
            _record_ids: Vec<String>
        ) -> SyncResult<()> {
            Ok(())
        }
    }

    #[async_trait::async_trait]
    impl crate::sync::traits::ConflictResolver for TestConflictResolver {
        async fn resolve_conflict(
            &self, 
            _table_name: &str, 
            _local_record: serde_json::Value, 
            _remote_record: serde_json::Value
        ) -> SyncResult<serde_json::Value> {
            Ok(serde_json::json!({}))
        }
    }
}
